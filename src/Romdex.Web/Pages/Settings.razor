@page "/settings"
@layout SettingsLayout
@inject RomdexClient Api

<PageTitle>Library settings · Romdex</PageTitle>

@* Where the library is, and how it's laid out: the Library section of Settings, as Melodex's (#238). *@

@if (_setup is null)
{
    <Loading />
}
else
{
    <h2>Folders</h2>
    <p class="muted small">Where Romdex looks, as the server sees it. They're set in the compose file, as <code>ROMS_PATH</code> and <code>DATS_PATH</code>.</p>
    <div class="card settings-card">
        <div class="setting-line">ROM library: <code>@_setup.LibraryPath</code>@(_setup.LibraryReadable ? "" : ", which Romdex can't open")</div>
        <div class="setting-line">DATs: <code>@_setup.DatPath</code>, with @Format.Count(_setup.DatFiles, "DAT", "DATs")</div>
    </div>

    <LibraryFormatPanel />

    <p class="muted small">Which regions you want games in is under <a href="settings/regions">Regions</a>; plugins (the catalogue, retrievers and connected apps) are under <a href="settings/plugins">Plugins</a>.</p>
}

@code {
    private SetupStatus? _setup;

    protected override async Task OnInitializedAsync() => _setup = await Api.GetSetupAsync();
}
