@page "/systems/{Id:guid}"
@implements IDisposable
@inject RomdexClient Api
@inject ServerEvents Events
@inject AuthState Auth
@inject GameLayout Layout

<PageTitle>@(_system?.Name ?? "System") · Romdex</PageTitle>

@if (_notFound)
{
    <div class="empty card">No such system. It may have left the catalogue with its DAT. <a href="">Library</a></div>
}
else if (_system is null)
{
    <Loading />
}
else
{
    <p class="small"><a href="">Library</a></p>
    <h1>@_system.Name</h1>
    <p class="muted small">Checked against @(_system.Source == "other" ? "its DAT" : $"{_system.Source}'s DAT"), version @_system.DatVersion@(_system.DatDate is { } date ? $" of {date:d MMM yyyy}" : "").</p>
    <div class="counts small">
        <span>@Format.Count(_system.Owned + _system.Partial + _system.Bad, "game", "games")</span>
        @if (_system.Partial > 0) { <span>@_system.Partial.ToString("N0") partial</span> }
        @if (_system.Bad > 0) { <span>@_system.Bad.ToString("N0") bad</span> }
    </div>

    <div class="toolbar">
        <Segmented T="string" Value="_filter" Options="GameFilters.Options" OnChange="FilterAsync" Label="Show" />
        <input type="search" placeholder="Search games" value="@_query" @oninput="SearchAsync" />
        <LayoutToggle Value="@_layout" OnChange="l => _layout = l" />
    </div>

    @if (_page is null)
    {
        <Loading />
    }
    else if (_page.Total == 0)
    {
        <div class="empty card">@(_query.Length > 0 ? "Nothing matches." : _filter == "All" ? "None of this system's games are in the library." : "Nothing here.")</div>
    }
    else
    {
        <TitleTable Titles="_titles" Grid="_layout == GameLayout.Grid" />
        @if (_titles.Count < _page.Total)
        {
            <div class="toolbar">
                <button @onclick="MoreAsync">Show more</button>
                <span class="muted small">@_titles.Count.ToString("N0") of @_page.Total.ToString("N0")</span>
            </div>
        }
    }

    @if (_bios is { } biosList && (biosList.Items.Count > 0 || biosList.Needed is not null))
    {
        var held = biosList.Items.Where(b => b.Status != DumpStatus.Missing).ToList();
        var missing = biosList.Items.Where(b => b.Status == DumpStatus.Missing).ToList();
        <h2>BIOS and firmware</h2>
        @if (biosList.Needed is { } need)
        {
            var names = string.Join(" or ", need.Files);
            <p class="small bios-need">
                @if (need.Ready)
                {
                    <span class="badge owned">Ready</span> <span>The library has a BIOS the browser's emulator can use.</span>
                }
                else if (need.Required)
                {
                    <span class="badge missing">Needed</span> <span>Games won't start in the browser without a BIOS. The emulator looks for @names.</span>
                }
                else
                {
                    <span class="badge neutral">Optional</span> <span>The browser's emulator plays most games without a BIOS, using a stand-in, and more with one. It looks for @names.</span>
                }
            </p>
        }
        <p class="muted small">The BIOS and firmware the system's DATs list. Emulators need some of them to start games.</p>
        @if (held.Count > 0)
        {
            <div class="card">
                <table class="table">
                    <tbody>
                        @foreach (var bios in held)
                        {
                            <tr>
                                <td>@bios.Name</td>
                                <td><span class="badge @Format.Badge(bios.Status)">@(bios.Status == DumpStatus.Good ? "Verified" : bios.Status.ToString())</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (missing.Count > 0)
        {
            <details>
                <summary>Not in the library (@missing.Count)</summary>
                <div class="card">
                    <table class="table">
                        <tbody>
                            @foreach (var bios in missing)
                            {
                                <tr><td>@bios.Name</td><td class="muted small">@string.Join(", ", bios.Regions)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    }

    @if (_filing is not null)
    {
        <h2>Filing</h2>
        <p class="muted small">How downloads are filed. Files already in the library stay as they are.</p>
        <div class="card filing">
            <label class="field">
                <span class="field-label">Folder</span>
                <select disabled="@(!CanFile)" @onchange="e => SetFilingAsync(_filing with { Layout = Enum.Parse<LibraryLayout>((string)e.Value!) })">
                    <option value="@LibraryLayout.Romm" selected="@(_filing.Layout == LibraryLayout.Romm)">A folder per platform, as RomM names them</option>
                    <option value="@LibraryLayout.DatName" selected="@(_filing.Layout == LibraryLayout.DatName)">A folder named as the DAT is: @_system.Name</option>
                </select>
            </label>
            <label class="field">
                <span class="field-label">Stored as</span>
                <select disabled="@(!CanFile)" @onchange="e => SetFilingAsync(_filing with { Storage = Enum.Parse<StorageFormat>((string)e.Value!) })">
                    @foreach (var format in _formats)
                    {
                        <option value="@format" selected="@(_filing.Storage == format)">@StorageLabel(format)</option>
                    }
                </select>
                <span class="muted small">A converted game is checked against the DAT before what it came as is deleted.</span>
            </label>
            <label class="field">
                <span class="field-label">Another dump of a game you have</span>
                <select disabled="@(!CanFile)" @onchange="e => SetFilingAsync(_filing with { Alternatives = Enum.Parse<AlternativePolicy>((string)e.Value!) })">
                    <option value="@AlternativePolicy.File" selected="@(_filing.Alternatives == AlternativePolicy.File)">File it beside the one you have</option>
                    <option value="@AlternativePolicy.Review" selected="@(_filing.Alternatives == AlternativePolicy.Review)">Hold it for review</option>
                    <option value="@AlternativePolicy.Discard" selected="@(_filing.Alternatives == AlternativePolicy.Discard)">Throw it away</option>
                </select>
            </label>
            @if (_filingError is not null) { <div class="error small">@_filingError</div> }
            <div class="toolbar">
                <button @onclick="CheckLibraryAsync" disabled="@_checking"
                        title="Compare the games already in the library with where Downloads would file them. Nothing is moved.">Check the library</button>
                @if (_adoption is { Problem: null } report && report.Checked > 0)
                {
                    <span class="muted small">@report.InPlace.ToString("N0") of @Format.Count(report.Checked, "game is", "games are") where Downloads would file @(report.Checked == 1 ? "it" : "them").</span>
                }
                else if (_adoption is { Problem: null })
                {
                    <span class="muted small">None of this system's games are in the library whole.</span>
                }
            </div>
            @if (_adoption?.Problem is { } problem) { <div class="error small">@problem</div> }
            @if (_adoption is { Moves.Count: > 0 } moves)
            {
                <p class="muted small">These would go elsewhere. Moving them isn't something Romdex does yet: this is so you can see what the settings would mean for the library you have.</p>
                <table class="table small">
                    <thead><tr><th>Game</th><th>Now</th><th>Would be</th></tr></thead>
                    <tbody>
                        @foreach (var move in moves.Moves)
                        {
                            <tr>
                                <td>@move.Dump.Name</td>
                                <td>@foreach (var path in move.From) { <div><code>@path</code></div> }</td>
                                <td>@foreach (var path in move.To) { <div><code>@path</code></div> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private const int PageSize = 100;

    private SystemSummary? _system;
    private bool _notFound;
    private BiosList? _bios;
    private TitlePage? _page;
    private List<TitleSummary> _titles = [];
    private string _filter = "All";
    private string _query = "";
    private int _search;
    private string _layout = GameLayout.Grid;
    private FilingSettings? _filing;
    private IReadOnlyList<StorageFormat> _formats = [];
    private string? _filingError;
    private AdoptionReport? _adoption;
    private bool _checking;

    private async Task CheckLibraryAsync()
    {
        _checking = true;
        try
        {
            _adoption = await Api.GetAdoptionAsync(Id);
        }
        catch (Exception e) when (e is RomdexApiException or HttpRequestException)
        {
            _adoption = new AdoptionReport(0, 0, [], e.Message);
        }
        finally
        {
            _checking = false;
        }
    }

    private bool CanFile => Auth.May(UserPermissions.Files);

    private static string StorageLabel(StorageFormat format) => format switch
    {
        StorageFormat.Keep => "As it arrives",
        StorageFormat.Loose => "Loose files",
        StorageFormat.Zip => "A zip per game",
        StorageFormat.Chd => "CHD, made with chdman",
        StorageFormat.Rvz => "RVZ, made with DolphinTool",
        _ => format.ToString(),
    };

    private async Task SetFilingAsync(FilingSettings filing)
    {
        _filingError = null;
        try
        {
            _filing = await Api.SetFilingAsync(Id, filing);
            _adoption = null;
        }
        catch (Exception e) when (e is RomdexApiException or HttpRequestException)
        {
            _filingError = e.Message;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        Events.Received -= OnEvent;
        Events.Received += OnEvent;
        _layout = await Layout.GetAsync();
        await LoadAsync();
    }

    private void OnEvent(string type)
    {
        if (type is "tasks")
            InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private async Task LoadAsync()
    {
        _system = await Api.GetSystemAsync(Id);
        _notFound = _system is null;
        if (_system is null)
            return;
        _bios = await Api.ListBiosAsync(Id);
        if (_filing is null)
        {
            _filing = await Api.GetFilingAsync(Id);
            _formats = await Api.ListStorageFormatsAsync(Id);
        }
        await LoadTitlesAsync(Math.Max(_titles.Count, PageSize));
    }

    private async Task LoadTitlesAsync(int take, int skip = 0)
    {
        var page = await Api.ListTitlesAsync(Id, GameFilters.StatusOf(_filter), _query, skip: skip, take: take, have: true);
        _page = page;
        _titles = skip == 0 ? [.. page.Items] : [.. _titles, .. page.Items];
    }

    private async Task FilterAsync(string value)
    {
        _filter = value;
        await LoadTitlesAsync(PageSize);
    }

    // Typing searches once it pauses.
    private async Task SearchAsync(ChangeEventArgs e)
    {
        _query = e.Value as string ?? "";
        var search = ++_search;
        await Task.Delay(250);
        if (search == _search)
            await LoadTitlesAsync(PageSize);
    }

    private Task MoreAsync() => LoadTitlesAsync(PageSize, _titles.Count);

    public void Dispose() => Events.Received -= OnEvent;
}
