@page "/titles/{Id:guid}"
@inject RomdexClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>@(_title?.Name ?? "Game") · Romdex</PageTitle>

@if (_notFound)
{
    <div class="empty card">No such game. It may have left the catalogue with its DAT. <a href="">Library</a></div>
}
else if (_title is null)
{
    <Loading />
}
else
{
    var held = _title.Dumps.Where(d => d.Status != DumpStatus.Missing).ToList();
    var others = _title.Dumps.Where(d => d.Status == DumpStatus.Missing).ToList();
    <p class="small"><a href="">Library</a> / <a href="systems/@_title.SystemId">@_title.SystemName</a></p>
    <div class="title-head">
        @if (_title.Cover is { } cover)
        {
            <img class="cover" src="@cover" alt="" />
        }
        <div>
            <div class="row">
                <h1>@_title.Name</h1>
                @if (Auth.May(UserPermissions.Download) && _title.Status != TitleStatus.Owned)
                {
                    <button @onclick="() => _getting = (null, _title.Name)" title="Find it through the retrievers">Get</button>
                }
            </div>
            @if (_title.KnownAs is { } knownAs)
            {
                <p class="muted">Also known as @knownAs</p>
            }
            @if (_title.Status != TitleStatus.Missing)
            {
                <p><span class="badge @Format.Badge(_title.Status)">@Format.Label(_title.Status)</span></p>
            }
        </div>
    </div>

    @if (held.Count == 0)
    {
        <div class="empty card">Not in the library.</div>
    }
    else
    {
        <h2>In your library</h2>
        <div class="card">
            @foreach (var dump in held) { @Dump(dump) }
        </div>
    }

    @if (others.Count > 0)
    {
        <details open="@(held.Count == 0)">
            <summary>@(held.Count == 0 ? "Dumps the DAT lists" : $"Other dumps the DAT lists ({others.Count})")</summary>
            <div class="card">
                @foreach (var dump in others) { @Dump(dump) }
            </div>
        </details>
    }

    @if (_getting is { } getting)
    {
        <GetDialog TitleId="Id" DumpId="getting.DumpId" Name="@getting.Name" OnClose="() => _getting = null" />
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private TitleDetail? _title;
    private bool _notFound;
    private (Guid? DumpId, string Name)? _getting;
    private readonly Dictionary<Guid, PlayInfo> _play = [];
    private readonly Dictionary<Guid, string> _opening = [];

    protected override async Task OnParametersSetAsync()
    {
        _title = await Api.GetTitleAsync(Id);
        _notFound = _title is null;
        _play.Clear();
        _opening.Clear();
        if (_title is null || !Auth.May(UserPermissions.Play))
            return;
        foreach (var dump in _title.Dumps.Where(d => d.Status == DumpStatus.Good))
            if (await Api.GetPlayAsync(dump.Id) is { } play)
                _play[dump.Id] = play;
    }

    // The player is a page of its own, outside the app: EmulatorJS is loaded there, and only there.
    private void Play(PlayInfo play) => Nav.NavigateTo(play.PlayerUrl!, forceLoad: true);

    private async Task OpenInAppAsync(PlayInfo play)
    {
        _opening[play.DumpId] = $"Finding it in {play.App}…";
        try
        {
            var link = await Api.OpenInAppAsync(play.DumpId);
            if (link.Url is { } url)
            {
                _opening.Remove(play.DumpId);
                Nav.NavigateTo(url, forceLoad: true);
            }
            else
            {
                _opening[play.DumpId] = link.Waiting ?? $"{link.App} hasn't found it yet.";
            }
        }
        catch (RomdexApiException e)
        {
            _opening[play.DumpId] = e.Message;
        }
    }

    private RenderFragment Dump(DumpInfo dump) => __builder =>
    {
        <div class="dump">
            <div class="dump-head">
                <span class="dump-name">@dump.Name</span>
                @if (dump.Status != DumpStatus.Missing)
                {
                    <span class="badge @Format.Badge(dump.Status)">@(dump.Status == DumpStatus.Good ? "Verified" : dump.Status.ToString())</span>
                }
                @if (dump.Status != DumpStatus.Good && Auth.May(UserPermissions.Download))
                {
                    <button class="small" @onclick="() => _getting = (dump.Id, dump.Name)" title="Find this dump through the retrievers">Get this dump</button>
                }
            </div>
            @if (_play.GetValueOrDefault(dump.Id) is { } play)
            {
                <div class="dump-actions">
                    @if (play.PlayerUrl is not null)
                    {
                        <button class="primary" @onclick="() => Play(play)" title="@(play.Bios is { } bios ? $"Plays in the browser, with {bios}" : "Plays in the browser")">Play</button>
                    }
                    @if (play.App is { } app)
                    {
                        <button @onclick="() => OpenInAppAsync(play)" title="Play it there, with its saves and states">Open in @app</button>
                    }
                    @if (_opening.GetValueOrDefault(dump.Id) is { } opening)
                    {
                        <span class="muted small">@opening</span>
                    }
                    else if (play.PlayerUrl is null && play.Unplayable is { } why)
                    {
                        <span class="muted small">@why</span>
                    }
                </div>
            }
            <div class="muted small">
                @string.Join(", ", dump.Regions)@(dump.Languages.Count > 0 ? $" · {string.Join(", ", dump.Languages)}" : "")
                @if (dump.Serial is not null) { <span> · @dump.Serial</span> }
                @if (dump.Kinds.Count > 0) { <span> · @string.Join(", ", dump.Kinds)</span> }
            </div>
            <div class="dump-files">
                @foreach (var file in dump.Files)
                {
                    <div class="file">
                        <span>@file.Name</span> <span class="muted">@Format.Size(file.Size)</span>
                        <div class="hashes">
                            @if (file.Crc32 is not null) { <code title="CRC32">@file.Crc32</code> }
                            @if (file.Sha1 is not null) { <code title="SHA-1">@file.Sha1</code> }
                            else if (file.Md5 is not null) { <code title="MD5">@file.Md5</code> }
                        </div>
                        @foreach (var place in file.Library)
                        {
                            <div class="muted">In the library as <code>@place.Path@(place.Entry is null ? "" : $" → {place.Entry}")</code></div>
                        }
                    </div>
                }
            </div>
        </div>
    };
}
