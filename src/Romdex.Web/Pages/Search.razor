@page "/search"
@inject RomdexClient Api
@inject NavigationManager Nav
@inject AuthState Auth
@inject GameLayout Layout

<PageTitle>Search · Romdex</PageTitle>

<h1>Search</h1>

<div class="toolbar">
    <input class="search-box" type="search" placeholder="Search every game the DATs list" aria-label="Search" value="@_query" @oninput="TypedAsync" @ref="_box" />
    @if (_systems.Count > 1)
    {
        <select aria-label="System" @onchange="SystemAsync">
            <option value="" selected="@(_system is null)">All systems</option>
            @foreach (var system in _systems)
            {
                <option value="@system.Id" selected="@(_system == system.Id)">@system.Name</option>
            }
        </select>
    }
    @* Coloured like the library's owned, all and missing, in the same order. *@
    <Segmented T="string" Value="_have" Options="HaveOptions" OnChange="HaveAsync" Label="In your library" Class="@($"ownership {(_have == "" ? "all" : _have)}")" />
</div>

@if (_error is not null)
{
    <div class="notice error">@_error</div>
}
else if (_systems.Count == 0 && _loaded)
{
    <div class="empty card">There's nothing to search yet. Search uses the catalogue: add DATs, then update it from the Library.</div>
}
else if (_page is null)
{
    <div class="empty card">
        Search for any game the catalogue's DATs list, whether or not it's in your library. Words can come in any order, and a game's
        regions and versions count too: <em>kart japan</em> finds the Japanese releases of a kart game.
    </div>
}
else if (_page.Total == 0)
{
    <div class="empty card">No games match@(_have != "" || _system is not null ? " with these filters" : "").</div>
}
else
{
    <div class="toolbar">
        <span class="muted small">@Format.Count(_page.Total, "game", "games")</span>
        <LayoutToggle Value="@_layout" OnChange="l => _layout = l" />
    </div>
    @if (_layout == GameLayout.Grid)
    {
        <div class="tiles game-tiles">
            @foreach (var game in _titles)
            {
                <GameTile @key="game.Id" Href="@($"titles/{game.Id}")" Name="@game.Name" Cover="@game.Cover" Status="game.Status" Systems="@Systems(game)">
                    @if (CanGet && game.Status != TitleStatus.Owned)
                    {
                        <IconButton Icon="get" Title="@($"Get {game.Name}")" Class="small" OnClick="() => _getting = game" />
                    }
                </GameTile>
            }
        </div>
    }
    else
    {
        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Game</th>
                        <th class="hide-narrow">System</th>
                        <th>In your library</th>
                        @if (CanGet) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in _titles)
                    {
                        <tr @key="game.Id">
                            <td><a class="game-name" href="titles/@game.Id"><Cover Url="@game.Cover" />@game.Name</a></td>
                            <td class="hide-narrow small"><SystemList Titles="@game.Titles.Select(t => (t.Id, Short(t.SystemId), t.Status, $"{t.Name} on {_names.GetValueOrDefault(t.SystemId)}")).ToList()" /></td>
                            <td><span class="badge @Format.Badge(game.Status)">@Format.OwnershipLabel(game.Status)</span></td>
                            @if (CanGet)
                            {
                                <td class="actions">
                                    @if (game.Status != TitleStatus.Owned) { <IconButton Icon="get" Title="@($"Get {game.Name}")" OnClick="() => _getting = game" /> }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (_titles.Count < _page.Total)
    {
        <div class="toolbar">
            <button @onclick="MoreAsync">Show more</button>
            <span class="muted small">@_titles.Count.ToString("N0") of @_page.Total.ToString("N0")</span>
        </div>
    }
}

@if (_getting is not null)
{
    @* The game on the system it's missing from, first: any title of an owned game is, as it isn't offered otherwise. *@
    var wanted = _getting.Titles.Where(t => t.Status != TitleStatus.Owned).ToList();
    <GetDialog TitleId="wanted[0].Id" Name="@_getting.Name" Versions="@wanted.Select(t => (t.Id, Short(t.SystemId))).ToList()" OnClose="() => _getting = null" />
}

@code {
    private const int PageSize = 50;
    private static readonly IReadOnlyList<(string Value, string Label, string? Hint)> HaveOptions =
        [("owned", "Owned", "Only what you have"), ("", "All", "Whether you have it or not"), ("missing", "Missing", "Only what you don't have")];

    [SupplyParameterFromQuery(Name = "q")] public string? QueryParameter { get; set; }

    private ElementReference _box;
    private bool _loaded;
    private IReadOnlyList<SystemSummary> _systems = [];
    private IReadOnlyDictionary<Guid, string> _names = new Dictionary<Guid, string>();
    private IReadOnlyDictionary<Guid, string> _short = new Dictionary<Guid, string>();
    private string _layout = GameLayout.Grid;
    private string _query = "";
    private Guid? _system;
    private string _have = "";
    private GamePage? _page;
    private List<GameSummary> _titles = [];
    private string? _error;
    private int _search;
    private GameSummary? _getting;

    // Getting a game asks the retrievers that search for it.
    private bool CanGet => Auth.May(UserPermissions.Download);

    protected override async Task OnInitializedAsync()
    {
        _systems = await Api.ListSystemsAsync();
        _names = _systems.ToDictionary(s => s.Id, s => s.Name);
        _short = _systems.ToDictionary(s => s.Id, Format.Short);
        _layout = await Layout.GetAsync();
        _query = QueryParameter ?? "";
        _loaded = true;
        await SearchAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _box.FocusAsync();
    }

    private string Short(Guid systemId) => _short.GetValueOrDefault(systemId) ?? "";

    // The systems a game is on, by short name, such as GC · PS2.
    private string Systems(GameSummary game) => string.Join(" · ", game.Titles.Select(t => Short(t.SystemId)).Distinct());

    // Typing searches once it pauses, and the address keeps the search so it can be shared or gone back to.
    private async Task TypedAsync(ChangeEventArgs e)
    {
        _query = e.Value as string ?? "";
        var search = ++_search;
        await Task.Delay(300);
        if (search != _search)
            return;
        Nav.NavigateTo(_query.Trim().Length == 0 ? "search" : $"search?q={Uri.EscapeDataString(_query.Trim())}", replace: true);
        await SearchAsync();
    }

    private Task SystemAsync(ChangeEventArgs e)
    {
        _system = Guid.TryParse(e.Value as string, out var id) ? id : null;
        return SearchAsync();
    }

    private Task HaveAsync(string value)
    {
        _have = value;
        return SearchAsync();
    }

    private async Task SearchAsync(int skip = 0)
    {
        _error = null;
        if (_query.Trim().Length == 0)
        {
            _page = null;
            _titles = [];
            return;
        }
        try
        {
            var have = _have switch { "owned" => true, "missing" => false, _ => (bool?)null };
            var page = await Api.SearchCatalogueAsync(_query.Trim(), _system, have, skip, PageSize);
            _page = page;
            _titles = skip == 0 ? [.. page.Items] : [.. _titles, .. page.Items];
        }
        catch (HttpRequestException e)
        {
            _error = $"Couldn't search: {e.Message}";
        }
    }

    private Task MoreAsync() => SearchAsync(_titles.Count);
}
