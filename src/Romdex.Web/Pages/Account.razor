@page "/settings/account"
@page "/account"
@layout SettingsLayout
@inject AuthState Auth
@inject RomdexClient Api

<PageTitle>Your account · Romdex</PageTitle>

@* Your own login, then signing out at the foot. It heads Settings, as Melodex's (#238), which also has your media
   server logins and scrobbling accounts. *@
@if (Auth.Status is { } status)
{
    <p class="muted">
        Signed in as <strong>@status.Username</strong>@(status.IsAdmin ? ", the admin, who may do everything." : ".")
    </p>
    <UserEditor Self="true" />
    <h2>Sign out</h2>
    <div class="card settings-card">
        <div class="setting-line">
            <span>Sign out of Romdex in this browser.</span>
            <span class="spacer"></span>
            <button class="danger" @onclick="SignOutAsync">Sign out</button>
        </div>
    </div>
}

@code {
    private async Task SignOutAsync()
    {
        await Api.SignOutAsync();
        Auth.Set(await Api.GetAuthStatusAsync());
    }
}
