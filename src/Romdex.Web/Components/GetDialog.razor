@inject RomdexClient Api

@*
    Gets a title through the retrievers that search: the best offer is fetched straight away, as Melodex does, and
    what it fetched is checked against the DAT before it's filed. A game on more than one system is got for one,
    picked first.
*@
<Dialog Title="@($"Get {Name}")" OnClose="OnClose" Class="get-dialog">
    @if (Versions is { Count: > 1 } && _result is null && !_fetching)
    {
        <p class="muted small">It's on more than one system. Which do you want?</p>
        <div class="toolbar">
            <Segmented T="Guid" Value="_titleId" Options="@(Versions.Select(v => (v.TitleId, v.System, (string?)null)).ToList())" OnChange="id => _titleId = id" Label="System" />
            <button class="primary" @onclick="FetchAsync">Get</button>
        </div>
    }
    else if (_result is null)
    {
        <Loading />
    }
    else
    {
        @if (_result.Download is { } started)
        {
            <p>@started.Source is fetching <strong>@started.Name</strong>. It's checked against the DAT and filed once it arrives; follow it on the <a href="downloads">Downloads page</a>.</p>
            <p class="muted small">If it isn't the right game, or it fails, it waits under <a href="review/couldnt-fetch">Review → Couldn't fetch</a>, where you can try again.</p>
        }
        else
        {
            <p>Nothing could be fetched.</p>
        }
        @foreach (var problem in _result.Problems)
        {
            <div class="notice @(_result.Download is null ? "error" : null) small">@problem</div>
        }
    }
    <div class="toolbar dialog-buttons">
        <button @onclick="OnClose">@(_result is null ? "Cancel" : "Close")</button>
    </div>
</Dialog>

@code {
    [Parameter, EditorRequired] public Guid TitleId { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>The one dump wanted; null for any of the title's.</summary>
    [Parameter] public Guid? DumpId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The game's titles on each system it's on, by short name, to pick which to get; <see cref="TitleId"/> is picked first.</summary>
    [Parameter] public IReadOnlyList<(Guid TitleId, string System)>? Versions { get; set; }

    private Guid _titleId;
    private TitleFetch? _result;
    private bool _fetching;

    protected override Task OnInitializedAsync()
    {
        _titleId = TitleId;
        return Versions is { Count: > 1 } ? Task.CompletedTask : FetchAsync();
    }

    private async Task FetchAsync()
    {
        _fetching = true;
        try
        {
            _result = await Api.FetchTitleAsync(_titleId, _titleId == TitleId ? DumpId : null);
        }
        catch (Exception e) when (e is RomdexApiException or HttpRequestException)
        {
            _result = new TitleFetch(null, [$"Couldn't get it: {e.Message}"]);
        }
        finally
        {
            _fetching = false;
        }
    }
}
