@inject RomdexClient Api

@* Finds a title through the retrievers that search, and has one of them fetch what it offered. *@
<Dialog Title="@($"Get {Name}")" OnClose="OnClose" Class="get-dialog">
    @if (_result is null)
    {
        <Loading />
    }
    else
    {
        @foreach (var problem in _result.Problems)
        {
            <div class="notice error small">@problem</div>
        }
        @if (_fetched is not null)
        {
            <p>@_fetched.Source is fetching it. It's identified and filed once it arrives; follow it on the <a href="downloads">Downloads page</a>.</p>
        }
        else if (_result.Offers.Count == 0)
        {
            <p class="muted">@(_result.Problems.Count > 0 ? "No other plugin offered anything." : "Nothing was offered. Retrievers that search, such as the inbox folder, are added in Settings.")</p>
        }
        else
        {
            <p class="muted small">
                What each plugin offered, its best first. Whatever you get is checked against the DAT before it's filed, so a wrong one waits on the
                Downloads page instead.
            </p>
            <div class="get-offers">
                @foreach (var offer in _result.Offers)
                {
                    var candidate = offer.Candidate;
                    <div class="get-offer">
                        <div class="get-offer-head">
                            <span class="dump-name">@candidate.Name</span>
                            @if (candidate.Verified == true) { <span class="badge owned" title="Its checksums match the DAT's">Verified</span> }
                            else if (candidate.Score is { } score) { <span class="badge neutral" title="How sure the plugin is">@score.ToString("P0")</span> }
                            <button class="primary" disabled="@_fetching" @onclick="() => FetchAsync(offer)">Get</button>
                        </div>
                        <div class="muted small">
                            @offer.Plugin · @candidate.Source
                            @if (candidate.DumpName is not null && candidate.DumpName != candidate.Name) { <span> · as @candidate.DumpName</span> }
                            @if (candidate.Format is not null) { <span> · @candidate.Format</span> }
                            @if (candidate.Size is { } size) { <span> · @Format.Size(size)</span> }
                            @if (candidate.Url is not null) { <span> · <a href="@candidate.Url" target="_blank" rel="noopener noreferrer">source</a></span> }
                        </div>
                        @if (candidate.Notes is not null)
                        {
                            <details class="small"><summary>Notes</summary><pre class="download-notes">@candidate.Notes</pre></details>
                        }
                    </div>
                }
            </div>
        }
        @if (_error is not null)
        {
            <div class="notice error small">@_error</div>
        }
    }
    <div class="toolbar dialog-buttons">
        <button @onclick="OnClose">@(_fetched is null ? "Cancel" : "Close")</button>
    </div>
</Dialog>

@code {
    [Parameter, EditorRequired] public Guid TitleId { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>The one dump wanted; null for any of the title's.</summary>
    [Parameter] public Guid? DumpId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private DownloadSearchResult? _result;
    private DownloadInfo? _fetched;
    private bool _fetching;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _result = await Api.SearchDownloadsAsync(TitleId, DumpId);
        }
        catch (Exception e) when (e is RomdexApiException or HttpRequestException)
        {
            _result = new DownloadSearchResult([], [$"Couldn't search: {e.Message}"]);
        }
    }

    private async Task FetchAsync(DownloadOffer offer)
    {
        _fetching = true;
        _error = null;
        try
        {
            _fetched = await Api.StartDownloadAsync(new StartDownload(TitleId, offer.PluginId, offer.Candidate, DumpId));
        }
        catch (Exception e) when (e is RomdexApiException or HttpRequestException)
        {
            _error = $"Couldn't get it: {e.Message}";
        }
        finally
        {
            _fetching = false;
        }
    }
}
