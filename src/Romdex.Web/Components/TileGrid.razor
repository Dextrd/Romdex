@typeparam TItem
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@inject IJSRuntime Js

@*
    A grid of tiles (Search's games) that draws only the rows near the screen, however many there are, fetching them a
    page at a time as they're scrolled to. How many tiles fit in a row depends on the width, so the grid is measured
    and its tiles grouped into rows of that many, again as it's resized. Rows not drawn are slots, shimmering in the
    shape of tiles, so the grid is as tall as all of them from the start and its scrollbar can be dragged anywhere.
*@
<div class="tile-grid" @ref="_element">
    @* An empty grid laid out as the rows are, to measure how many fit. *@
    <div class="tiles tile-probe @Class" aria-hidden="true"></div>
    @if (_columns > 0)
    {
        <Virtualize @ref="_rows" ItemsProvider="RowsAsync" Context="row" ItemSize="_rowHeight" OverscanCount="3">
            <ItemContent>
                <div class="tiles tile-row @Class" @key="row.Start">
                    @foreach (var item in row.Items)
                    {
                        @ChildContent(item)
                    }
                </div>
            </ItemContent>
            <Placeholder>
                @* A row still being fetched is a row of slots, as the rows not drawn are. *@
                <div style="height: @(_rowHeight.ToString(System.Globalization.CultureInfo.InvariantCulture))px"></div>
            </Placeholder>
        </Virtualize>
    }
</div>

@code {
    [Parameter, EditorRequired] public PagedItems<TItem> Items { get; set; } = null!;

    [Parameter, EditorRequired] public RenderFragment<TItem> ChildContent { get; set; } = null!;

    /// <summary>Classes for the rows' grids, such as <c>game-tiles</c>, which sets how wide a tile is.</summary>
    [Parameter] public string? Class { get; set; }

    private sealed record Row(int Start, IReadOnlyList<TItem> Items);

    private ElementReference _element;
    private Virtualize<Row>? _rows;
    private IJSObjectReference? _module, _observer;
    private DotNetObjectReference<TileGrid<TItem>>? _self;
    private int _columns;
    private float _rowHeight = 300;
    private bool _disposed;

    private async ValueTask<ItemsProviderResult<Row>> RowsAsync(ItemsProviderRequest request)
    {
        var columns = _columns;
        var items = await Items.GetAsync(request.StartIndex * columns, request.Count * columns);
        var rows = items.Chunk(columns).Select((chunk, i) => new Row((request.StartIndex + i) * columns, chunk)).ToList();
        return new ItemsProviderResult<Row>(rows, (Items.Total + columns - 1) / columns);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _self = DotNetObjectReference.Create(this);
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/grid.js");
        // Left before the script loaded: its reference is gone, so there's nothing to watch.
        if (_disposed)
            return;
        var observer = await _module.InvokeAsync<IJSObjectReference>("observe", _element, _self);
        if (_disposed)
        {
            await observer.InvokeVoidAsync("dispose");
            await observer.DisposeAsync();
            return;
        }
        _observer = observer;
    }

    /// <summary>How many tiles fit in a row now, and how tall a row is with the gap below it.</summary>
    [JSInvokable]
    public async Task Measured(int columns, float rowHeight)
    {
        if (columns == _columns && (rowHeight <= 0 || Math.Abs(rowHeight - _rowHeight) < 1))
            return;
        var regroup = Math.Max(1, columns) != _columns && _rows is not null;
        _columns = Math.Max(1, columns);
        if (rowHeight > 0)
            _rowHeight = rowHeight;
        StateHasChanged();
        // Rows already drawn were grouped for the old width.
        if (regroup)
            await _rows!.RefreshDataAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
}
