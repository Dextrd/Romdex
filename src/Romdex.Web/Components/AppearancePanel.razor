@inject RomdexClient Api
@inject AuthState Auth
@inject Theme Theme
@implements IDisposable

@*
    How the web app looks, or which notifications it shows: for whoever's signed in, kept with their account, or for
    everyone who hasn't chosen their own. Each choice shows at once where it's what you see. Both are kept together, so
    choosing either makes them your own.
*@
<section class="panel" aria-label="@Title">
    <header class="panel-head">
        <div class="panel-title">
            <h2>@Title</h2>
            <p class="muted small">
                @if (ForEveryone)
                {
                    <span>@(Notifications ? "The notifications" : "How Romdex looks") for everyone who hasn't chosen their own. Each person can choose their own under Settings → Web app.</span>
                }
                else if (Auth.Status?.OwnAppearance == true)
                {
                    <span>@(Notifications ? "The notifications you see" : "How Romdex looks for you"), on every device you sign in on. </span>
                    <button class="link" disabled="@_saving" @onclick="FollowEveryoneAsync">Use everyone's instead</button>
                }
                else
                {
                    <span>You're following the @(Notifications ? "notifications" : "look") chosen for everyone. Change anything here to make @(Notifications ? "them" : "it") your own, on every device you sign in on.</span>
                }
            </p>
        </div>
        @if (_saving) { <span class="spinner"></span> }
        @Switch
    </header>
    <div class="appearance">
        @if (Notifications)
        {
            <p class="muted small">They slide in at the bottom right while you use Romdex.</p>
            @foreach (var (name, hint, on, set) in NoticeKinds)
            {
                <label class="dialog-choice">
                    <input type="checkbox" checked="@on(_appearance)" @onchange="e => SaveAsync(set(_appearance, (bool)e.Value!))" />
                    <span><strong>@name</strong><span class="muted small">@hint</span></span>
                </label>
            }
        }
        else
        {
        <div class="field-label">Colour</div>
        <div class="swatches" role="radiogroup" aria-label="Colour">
            @foreach (var (color, name, light, dark) in Theme.Colors)
            {
                <button type="button" role="radio" aria-checked="@(_appearance.Color == color ? "true" : "false")"
                        class="swatch @(_appearance.Color == color ? "selected" : "")" @onclick="() => SaveAsync(_appearance with { Color = color })">
                    <span class="swatch-dot" style="--light: @light; --dark: @dark" aria-hidden="true"></span>
                    @name
                </button>
            }
        </div>

        <div class="field-label">Light or dark</div>
        <div class="mode-choices" role="radiogroup" aria-label="Light or dark">
            @foreach (var (mode, name, hint) in Theme.Modes)
            {
                <label class="dialog-choice">
                    <input type="radio" name="@($"mode-{(ForEveryone ? "everyone" : "you")}")" checked="@(_appearance.Mode == mode)" @onchange="() => SaveAsync(_appearance with { Mode = mode })" />
                    <span><strong>@name</strong><span class="muted small">@hint</span></span>
                </label>
            }
        </div>

        <label class="dialog-choice">
            <input type="checkbox" checked="@_appearance.HighContrast" @onchange="e => SaveAsync(_appearance with { HighContrast = (bool)e.Value! })" />
            <span>
                <strong>High contrast</strong>
                <span class="muted small">Stronger text and borders, and owned, partial, covered and missing in colours that colour-blind people can tell apart</span>
            </span>
        </label>

        <div class="field-label">Age ratings</div>
        @* Whose ratings games' pages show in their corner; a game none of theirs is known for shows another board's. *@
        <div class="rating-choices" role="radiogroup" aria-label="Age ratings">
            <label class="dialog-choice">
                <input type="radio" name="@($"ratings-{(ForEveryone ? "everyone" : "you")}")" checked="@(_appearance.Ratings == RatingBoard.Auto)"
                       @onchange="() => SaveAsync(_appearance with { Ratings = RatingBoard.Auto })" />
                <span><strong>Automatic</strong><span class="muted small">By your browser's language</span></span>
            </label>
            @foreach (var (board, name, where, sample) in Format.RatingBoards)
            {
                <label class="dialog-choice rating-choice">
                    <input type="radio" name="@($"ratings-{(ForEveryone ? "everyone" : "you")}")" checked="@(_appearance.Ratings == board)"
                           @onchange="() => SaveAsync(_appearance with { Ratings = board })" />
                    <img src="img/ratings/@(sample).svg" alt="" />
                    <span><strong>@name</strong><span class="muted small">@where</span></span>
                </label>
            }
            <label class="dialog-choice">
                <input type="radio" name="@($"ratings-{(ForEveryone ? "everyone" : "you")}")" checked="@(_appearance.Ratings == RatingBoard.None)"
                       @onchange="() => SaveAsync(_appearance with { Ratings = RatingBoard.None })" />
                <span><strong>Don't show them</strong></span>
            </label>
        </div>
        }
        @if (_error is not null) { <p class="error small">@_error</p> }
    </div>
</section>

@code {
    /// <summary>Everyone's look, rather than your own.</summary>
    [Parameter] public bool ForEveryone { get; set; }

    /// <summary>Which notifications show, rather than the look.</summary>
    [Parameter] public bool Notifications { get; set; }

    /// <summary>Shown at the top right, such as the switch between your own look and everyone's.</summary>
    [Parameter] public RenderFragment? Switch { get; set; }

    private static readonly IReadOnlyList<(string Name, string Hint, Func<Appearance, bool> On, Func<Appearance, bool, Appearance> Set)> NoticeKinds =
    [
        ("Long tasks", "When a scan, catalogue update or formatting finishes or fails, and when a scan leaves something to review",
            a => a.TaskNotices, (a, on) => a with { TaskNotices = on }),
        ("Fetches", "When you ask for something, and when it's in your library or failed",
            a => a.DownloadNotices, (a, on) => a with { DownloadNotices = on }),
        ("Menus", "When what you do from a menu goes on elsewhere, and when it's done",
            a => a.ActionNotices, (a, on) => a with { ActionNotices = on }),
    ];

    private Appearance _appearance = new();
    private bool _saving;
    private string? _error;

    private string Title => (Notifications ? "Notifications" : "Appearance") + (ForEveryone ? " for everyone" : "");

    // Everyone's look shows as you change it only while you follow it.
    private bool Shown => !ForEveryone || Auth.Status?.OwnAppearance != true;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        _appearance = Auth.Status?.Appearance ?? new Appearance();
        if (ForEveryone)
        {
            try
            {
                _appearance = await Api.GetDefaultAppearanceAsync();
            }
            catch (Exception e) when (e is HttpRequestException or RomdexApiException)
            {
                _error = "Couldn't read everyone's look.";
            }
        }
    }

    private async Task SaveAsync(Appearance appearance)
    {
        _appearance = appearance;
        _error = null;
        if (Shown)
            await Theme.ApplyAsync(appearance);
        _saving = true;
        try
        {
            if (ForEveryone)
            {
                await Api.SetDefaultAppearanceAsync(appearance);
                if (Shown && Auth.Status is { } status)
                    Auth.Set(status with { Appearance = appearance });
            }
            else
            {
                await Api.SetAppearanceAsync(appearance);
                if (Auth.Status is { } status)
                    Auth.Set(status with { Appearance = appearance, OwnAppearance = true });
            }
        }
        catch (RomdexApiException e)
        {
            _error = ForEveryone ? $"Couldn't keep it: {e.Message}" : $"Couldn't keep it with your account: {e.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task FollowEveryoneAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            _appearance = await Api.ClearAppearanceAsync();
            await Theme.ApplyAsync(_appearance);
            if (Auth.Status is { } status)
                Auth.Set(status with { Appearance = _appearance, OwnAppearance = false });
        }
        catch (RomdexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    // Following everyone's look, yours changes when theirs does.
    private void OnAuthChanged()
    {
        if (!ForEveryone && Auth.Status is { OwnAppearance: false, Appearance: { } appearance })
        {
            _appearance = appearance;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
